{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://cdn.jsdelivr.net https://storage.googleapis.com; frame-src https://www.youtube-nocookie.com https://www.youtube.com; worker-src 'self' blob:; child-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self' https://*.myshopify.com https://checkout.stripe.com; upgrade-insecure-requests"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-site"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "functions": {
    "api/preguntar.js": {
      "maxDuration": 60
    },
    "api/generar-plan.js": {
      "maxDuration": 60
    },
    "api/auth.js": {
      "maxDuration": 30
    },
    "api/stripe-webhook.js": {
      "maxDuration": 30
    },
    "api/recordatorios.js": {
      "maxDuration": 60
    },
    "api/admin.js": {
      "maxDuration": 30
    },
    "api/pagos.js": {
      "maxDuration": 30
    },
    "api/datos.js": {
      "maxDuration": 30
    },
    "api/social.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/recordatorios",
      "schedule": "0 7 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/admin-resumen",
      "destination": "/api/admin?m=resumen"
    },
    {
      "source": "/api/admin-profesionales",
      "destination": "/api/admin?m=profesionales"
    },
    {
      "source": "/api/panel-admin",
      "destination": "/api/admin?m=panel"
    },
    {
      "source": "/api/visita",
      "destination": "/api/admin?m=visita"
    },
    {
      "source": "/api/crear-pago-sesion",
      "destination": "/api/pagos?m=crear"
    },
    {
      "source": "/api/cancelar-reserva",
      "destination": "/api/pagos?m=cancelar"
    },
    {
      "source": "/api/progreso",
      "destination": "/api/datos?m=progreso"
    },
    {
      "source": "/api/entrenos",
      "destination": "/api/datos?m=entrenos"
    },
    {
      "source": "/api/equipo",
      "destination": "/api/social?m=equipo"
    },
    {
      "source": "/api/grupos",
      "destination": "/api/social?m=grupos"
    }
  ]
}